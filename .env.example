# Server
PORT=3000
NODE_ENV=development

# Text limits
MAX_TEXT_LENGTH=10000

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Canvas rendering
JPEG_QUALITY=90

# Visual tuning & Debug mode
# Set to true to generate multiple variations per request for visual comparison
DEBUG=false

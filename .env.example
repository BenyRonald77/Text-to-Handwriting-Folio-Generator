# Server
PORT=3000
# Production behind Nginx: 127.0.0.1 so port 3000 is not reachable from outside.
HOST=0.0.0.0
NODE_ENV=development

# Behind a reverse proxy (Nginx): set to 1 so rate limiting sees the real
# client IP from X-Forwarded-For. Leave empty when running without a proxy.
TRUST_PROXY=

# Access protection (HTTP Basic Auth, shared with friends)
# Empty BASIC_AUTH_PASS = auth disabled (fine for local development).
BASIC_AUTH_USER=teman
BASIC_AUTH_PASS=

# Text limits
MAX_TEXT_LENGTH=10000

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=20

# Canvas rendering
JPEG_QUALITY=90

# Visual tuning & Debug mode
# Set to true to generate multiple variations per request for visual comparison
DEBUG=false
